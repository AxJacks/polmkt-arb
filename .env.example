# ───────────────────────────────────────────────────────────────
# polmkt-arb environment. Copy to `.env` and fill in. NEVER commit .env.
# Secrets live ONLY here (or your real secret store), never in code.
# ───────────────────────────────────────────────────────────────

# ── Kalshi (RSA request signing) ────────────────────────────────
# Key ID from the Kalshi web app -> Profile -> API Keys.
KALSHI_API_KEY_ID=
# Path to the RSA private key file Kalshi issued (PEM). Keep it 0600.
KALSHI_PRIVATE_KEY_PATH=./secrets/kalshi_rsa_private.pem
# Hosts (override only for demo/testing).
KALSHI_REST_BASE=https://external-api.kalshi.com/trade-api/v2
KALSHI_WS_URL=wss://external-api-ws.kalshi.com/trade-api/ws/v2

# ── Polymarket US (Ed25519 request signing) ─────────────────────
# Key ID + base64 Secret Key from polymarket.us/developer (post-KYC).
POLYUS_KEY_ID=
POLYUS_SECRET_KEY=
POLYUS_REST_BASE=https://api.polymarket.us/v1
POLYUS_WS_URL=wss://api.polymarket.us/v1/ws/markets

# ── Anthropic (Haiku candidate suggester only) ──────────────────
ANTHROPIC_API_KEY=
SUGGESTER_MODEL=claude-haiku-4-5

# ── Detector / edge config (Phase 1) ────────────────────────────
MIN_EDGE=0.02
MIN_SIZE=10
SLIPPAGE_BUFFER=0.005
STALENESS_MS=30000
SETTLEMENT_WINDOW_S=3600
EDGE_POLL_MS=500

# ── Alerts ──────────────────────────────────────────────────────
RECOS_XLSX=./recos.xlsx
ALERT_WEBHOOK_URL=

# ── Phase 2 executor (OFF by default — do not enable lightly) ────
ARMED=false
MODE=paper                      # paper | live  (live also needs --live flag)
MAX_CONTRACTS_PER_MARKET=20
MAX_TOTAL_CAPITAL=100
MAX_CONCURRENT_ARBS=2
MAX_ORDER_SIZE=10
MAX_DAILY_LOSS=15
LEG2_TIMEOUT_MS=1500
KILL_SWITCH_FILE=./HALT
